{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "rootDir": "src",
    "outDir": "build",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ES2022.Intl"],
    "types": ["node"],
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
